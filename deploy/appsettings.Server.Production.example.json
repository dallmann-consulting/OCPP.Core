{
  // Copy to /home/frederic/OCPP/server/appsettings.Production.json and fill in the values.
  "Logging": {
    // Logs go to the console -> journald (journalctl -u OcppServer); no log files on the SD card.
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "LogLevel": { "Default": "None", "OCPP": "None", "Microsoft": "None" }
    }
  },

  "ConnectionStrings": {
    "SqlServer": "",
    "SQLite": "Filename=/mnt/data/ocpp/OCPP.Core.sqlite"
  },

  "MessageDumpDir": "",
  "DbMessageLog": 1, // 1 = Info (no MeterValues), 2 = everything

  // New key, the same as in the Management settings (generate with: uuidgen)
  "ApiKey": "VUL-IN",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        // On the LAN, so the Alfen can connect (ws://192.168.0.160:8081/OCPP)
        "Url": "http://0.0.0.0:8081"
      }
    }
  }
}
