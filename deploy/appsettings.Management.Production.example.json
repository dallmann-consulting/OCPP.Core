{
  // Copy to /home/frederic/OCPP/mgmt/appsettings.Production.json and fill in the values.
  "Logging": {
    // Logs go to the console -> journald (journalctl -u OcppManagement); no log files on the SD card.
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "LogLevel": { "Default": "None", "OCPP": "None", "Microsoft": "None" }
    }
  },

  "ConnectionStrings": {
    "SqlServer": "",
    "HangfireDb": "", // empty = Hangfire in-memory
    "SQLite": "Filename=/mnt/data/ocpp/OCPP.Core.sqlite"
  },

  "ServerApiUrl": "http://127.0.0.1:8081/API",
  "ApiKey": "VUL-IN", // the same as in the Server settings

  "DataProtectionKeysPath": "/mnt/data/ocpp/keys",

  "Hangfire": {
    "DashboardUser": "frederic",
    "DashboardPassword": "VUL-IN"
  },

  "SmtpSettings": {
    "Password": "VUL-IN"
  },

  // Overrides the upstream defaults admin/t3st and user/t3st from appsettings.json
  "Users": [
    { "Username": "VUL-IN", "Password": "VUL-IN", "Administrator": true },
    { "Username": "user", "Password": "VUL-IN", "Administrator": false }
  ],

  "Kestrel": {
    "Endpoints": {
      "Http": {
        // Local only; via the tailnet: tailscale serve --https=8445 http://127.0.0.1:8082
        "Url": "http://127.0.0.1:8082"
      }
    }
  }
}
